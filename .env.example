# Copia este archivo como .env y completa los valores. El .env no se sube a git.
# Si la contraseña tiene caracteres como @ : / # %, escríbela codificada (por ejemplo @ → %40).

# Puerto del servidor web
PORT=3000

# Base de datos de la aplicación
DATABASE_URL=postgres://stockvoz:CAMBIAR@localhost:5432/stockvoz

# Base solo para `node --test`: se BORRA en cada corrida, por eso debe terminar en _prueba
DATABASE_URL_PRUEBA=postgres://stockvoz:CAMBIAR@localhost:5432/stockvoz_prueba

# 1 = crear las cuentas y negocios de demostración si la base está vacía; 0 = no
STOCKVOZ_DEMO=1

# 1 = la cookie de sesión solo viaja por HTTPS (obligatorio al publicar); 0 en local
STOCKVOZ_COOKIE_SEGURA=0

# Interpretación con IA. Dos modos (ver docs/contrato-n8n.md):
#   0        solo el intérprete por reglas; no necesita nada más
#   n8n      la frase va al flujo de n8n, que llama al modelo (la arquitectura del proyecto)
#   directo  la frase va a una API compatible con OpenAI (Groq, DeepSeek…), sin n8n
# En los dos casos, si la IA falla se usa el intérprete por reglas.
STOCKVOZ_IA=0

# --- Modo n8n ---
# Webhook del flujo y secreto compartido con él, de al menos 16 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
N8N_URL=http://localhost:5678/webhook/stockvoz-interpretar
N8N_SECRETO=

# --- Modo directo ---
# Tu clave del proveedor. NUNCA la subas a git ni la pegues en un chat.
IA_CLAVE=
# Por defecto, Groq con el modelo gpt-oss-20b. Para DeepSeek:
#   IA_URL=https://api.deepseek.com/chat/completions
#   IA_MODELO=deepseek-flash
#   IA_ESQUEMA_ESTRICTO=0   (DeepSeek no garantiza el esquema, solo que sea JSON)
IA_URL=https://api.groq.com/openai/v1/chat/completions
IA_MODELO=openai/gpt-oss-20b
# Esfuerzo de razonamiento: con low acierta igual y gasta 3 veces menos tokens de salida.
IA_ESFUERZO=low
IA_ESQUEMA_ESTRICTO=1

# --- Comunes a los dos modos ---
# Milisegundos que se espera antes de usar el respaldo por reglas
N8N_TIMEOUT_MS=6000
# Interpretaciones con IA por negocio y por día; pasado el tope se usan las reglas
STOCKVOZ_IA_LIMITE_DIARIO=500

# --- Dictado por voz (Whisper) ---
# 1 para transcribir en el servidor con Whisper; 0 (o sin poner) deja el dictado del navegador,
# que solo anda en Chrome/Edge y le manda el audio a Google.
STOCKVOZ_VOZ=1
# Usa IA_CLAVE por defecto. VOZ_CLAVE solo si quieres una cuenta distinta a la de la interpretación.
#VOZ_CLAVE=
#VOZ_URL=https://api.groq.com/openai/v1/audio/transcriptions
#VOZ_MODELO=whisper-large-v3-turbo
#VOZ_IDIOMA=es
#VOZ_TIMEOUT_MS=20000
# Transcripciones por negocio y día. El plan gratuito de Groq da 2.000 al día en total.
#STOCKVOZ_VOZ_LIMITE_DIARIO=200
