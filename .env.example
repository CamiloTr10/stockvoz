# Copia este archivo como .env y completa los valores. El .env no se sube a git.
# Si la contraseña tiene caracteres como @ : / # %, escríbela codificada (por ejemplo @ → %40).

# Puerto del servidor web
PORT=3000

# Base de datos de la aplicación
DATABASE_URL=postgres://stockvoz:CAMBIAR@localhost:5432/stockvoz

# Base solo para `node --test`: se BORRA en cada corrida, por eso debe terminar en _prueba
DATABASE_URL_PRUEBA=postgres://stockvoz:CAMBIAR@localhost:5432/stockvoz_prueba

# 1 = crear las cuentas y negocios de demostración si la base está vacía; 0 = no
STOCKVOZ_DEMO=1

# 1 = la cookie de sesión solo viaja por HTTPS (obligatorio al publicar); 0 en local
STOCKVOZ_COOKIE_SEGURA=0
