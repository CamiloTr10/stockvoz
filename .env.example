# Copia este archivo como .env y completa los valores. El .env no se sube a git.
# Si la contraseña tiene caracteres como @ : / # %, escríbela codificada (por ejemplo @ → %40).

# Puerto del servidor web
PORT=3000

# Base de datos de la aplicación
DATABASE_URL=postgres://stockvoz:CAMBIAR@localhost:5432/stockvoz

# Base solo para `node --test`: se BORRA en cada corrida, por eso debe terminar en _prueba
DATABASE_URL_PRUEBA=postgres://stockvoz:CAMBIAR@localhost:5432/stockvoz_prueba

# 1 = crear las cuentas y negocios de demostración si la base está vacía; 0 = no
STOCKVOZ_DEMO=1

# 1 = la cookie de sesión solo viaja por HTTPS (obligatorio al publicar); 0 en local
STOCKVOZ_COOKIE_SEGURA=0

# Interpretación con IA a través de n8n (ver docs/contrato-n8n.md).
# 0 = solo el intérprete por reglas (no necesita nada más); 1 = usar la IA, con las reglas como respaldo
STOCKVOZ_IA=0
# Dirección del webhook de n8n (solo si STOCKVOZ_IA=1)
N8N_URL=http://localhost:5678/webhook/stockvoz-interpretar
# Secreto compartido con el flujo de n8n, de al menos 16 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
N8N_SECRETO=
# Milisegundos que se espera a n8n antes de usar el respaldo
N8N_TIMEOUT_MS=6000
# Interpretaciones con IA por negocio y por día; pasado el tope se usan las reglas
STOCKVOZ_IA_LIMITE_DIARIO=500
